<section class="section section-alt">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Contact Us</span>
      <h1>We'd Love to Hear From You</h1>
      <p>Reach out with questions about admissions, fees, or anything else &mdash; our office team typically responds within one working day.</p>
    </div>

    <div class="grid grid-4">
      <div class="card contact-info-card reveal">
        <div class="card-icon"><%- icon('mapPin') %></div>
        <div><h4>Address</h4><p><%= school.address %></p></div>
      </div>
      <div class="card contact-info-card reveal">
        <div class="card-icon green"><%- icon('phone') %></div>
        <div><h4>Phone</h4><p><a href="tel:<%= school.phone.replace(/\s+/g, '') %>"><%= school.phone %></a></p></div>
      </div>
      <div class="card contact-info-card reveal">
        <div class="card-icon"><%- icon('mail') %></div>
        <div><h4>Email</h4><p><a href="mailto:<%= school.officeEmail %>"><%= school.officeEmail %></a></p></div>
      </div>
      <div class="card contact-info-card reveal">
        <div class="card-icon green"><%- icon('clock') %></div>
        <div><h4>Office Hours</h4><p><%= school.officeHours %></p></div>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container grid grid-2" style="gap:48px; align-items:flex-start;">
    <div class="reveal">
      <span class="eyebrow">Send a Message</span>
      <h2>Contact Form</h2>

      <% if (typeof submitted !== 'undefined' && submitted) { %>
        <div class="alert alert-success">
          <%- icon('checkCircle') %>
          <span>Thank you! We've received your message and will get back to you soon. A confirmation email has been sent to your address.</span>
        </div>
      <% } %>

      <div class="card">
        <form action="/contact" method="POST" novalidate>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <%- include('partials/form-field', { type: 'text', name: 'name', label: 'Your Name', value: formValues.name, error: errors.name }) %>
          <%- include('partials/form-field', { type: 'tel', name: 'phone', label: 'Phone Number', value: formValues.phone, error: errors.phone, placeholder: '03XX-XXXXXXX' }) %>
          <%- include('partials/form-field', { type: 'email', name: 'email', label: 'Email Address', value: formValues.email, error: errors.email }) %>
          <%- include('partials/form-field', { type: 'select', name: 'reason', label: 'Reason for Contact', value: formValues.reason, error: errors.reason, options: reasons }) %>
          <%- include('partials/form-field', { type: 'textarea', name: 'message', label: 'Message', value: formValues.message, error: errors.message }) %>
          <button type="submit" class="btn btn-primary btn-block">Send Message</button>
        </form>
      </div>

      <a href="https://wa.me/<%= school.whatsappNumber %>" target="_blank" rel="noopener" class="btn btn-secondary" style="margin-top:16px;">
        <%- icon('whatsapp') %> Chat With Us on WhatsApp
      </a>
    </div>

    <div class="reveal">
      <span class="eyebrow">Find Us</span>
      <h2>Campus Location</h2>
      <div class="map-frame">
        <iframe src="<%= school.mapsEmbedUrl %>" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Campus location map"></iframe>
      </div>
    </div>
  </div>
</section>
