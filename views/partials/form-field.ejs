<%
  // Expected locals: type, name, label, value, error, options (for select), placeholder, required, full, hint, rows
  var fieldType = typeof type !== 'undefined' ? type : 'text';
  var fieldValue = typeof value !== 'undefined' && value !== undefined && value !== null ? value : '';
  var fieldError = typeof error !== 'undefined' ? error : null;
  var isFull = typeof full !== 'undefined' && full;
  var isRequired = typeof required === 'undefined' || required;
%>
<div class="field<%= isFull ? ' full' : '' %><%= fieldError ? ' has-error' : '' %>">
  <label for="field-<%= name %>"><%= label %><%= isRequired ? '' : ' (optional)' %></label>
  <% if (fieldType === 'select') { %>
    <select id="field-<%= name %>" name="<%= name %>" <%= isRequired ? 'required' : '' %>>
      <option value="" <%= !fieldValue ? 'selected' : '' %> disabled>Select...</option>
      <% (options || []).forEach(function(opt) {
           var optValue = typeof opt === 'object' ? opt.value : opt;
           var optLabel = typeof opt === 'object' ? opt.label : opt;
      %>
        <option value="<%= optValue %>" <%= String(fieldValue) === String(optValue) ? 'selected' : '' %>><%= optLabel %></option>
      <% }) %>
    </select>
  <% } else if (fieldType === 'textarea') { %>
    <textarea id="field-<%= name %>" name="<%= name %>" rows="<%= typeof rows !== 'undefined' ? rows : 4 %>" placeholder="<%= typeof placeholder !== 'undefined' ? placeholder : '' %>" <%= isRequired ? 'required' : '' %>><%= fieldValue %></textarea>
  <% } else { %>
    <input type="<%= fieldType %>" id="field-<%= name %>" name="<%= name %>" value="<%= fieldValue %>" placeholder="<%= typeof placeholder !== 'undefined' ? placeholder : '' %>" <%= isRequired ? 'required' : '' %> />
  <% } %>
  <% if (typeof hint !== 'undefined' && hint) { %><span class="hint"><%= hint %></span><% } %>
  <% if (fieldError) { %><span class="field-error"><%= fieldError %></span><% } %>
</div>
