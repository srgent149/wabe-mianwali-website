<div class="admin-topline"><h2>Faculty</h2></div>

<div class="admin-panel">
  <h3 id="form-title">Add / Edit Faculty Member</h3>
  <form action="/admin/faculty" method="POST" enctype="multipart/form-data" id="fac-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <input type="hidden" name="id" id="fac-id" value="" />
    <div class="form-grid">
      <div class="field"><label>Name</label><input type="text" name="name" id="fac-name" required /></div>
      <div class="field"><label>Role</label><input type="text" name="role" id="fac-role" required /></div>
      <div class="field"><label>Department</label><input type="text" name="department" id="fac-department" required /></div>
      <div class="field"><label>Qualification</label><input type="text" name="qualification" id="fac-qualification" required /></div>
      <div class="field"><label>Years of Experience</label><input type="number" name="yearsExperience" id="fac-yearsExperience" min="0" required /></div>
      <div class="field"><label>Display Order</label><input type="number" name="displayOrder" id="fac-displayOrder" value="0" /></div>
      <div class="field"><label>Photo (optional)</label><input type="file" name="photo" accept=".jpg,.jpeg,.png,.webp" /></div>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <button type="button" class="btn btn-outline" data-reset-form="fac-form" data-reset-id="fac-id">Clear</button>
  </form>
</div>

<div class="table-wrap">
  <table class="data-table">
    <thead><tr><th>Name</th><th>Role</th><th>Department</th><th>Experience</th><th></th></tr></thead>
    <tbody>
      <% faculty.forEach(function(f) { %>
        <tr>
          <td><%= f.name %></td>
          <td><%= f.role %></td>
          <td><%= f.department %></td>
          <td><%= f.yearsExperience %> yrs</td>
          <td style="white-space:nowrap;">
            <% var facEditData = { id: f.id, name: f.name, role: f.role, department: f.department, qualification: f.qualification, yearsExperience: f.yearsExperience, displayOrder: f.displayOrder }; %>
            <button type="button" class="btn btn-outline btn-sm" data-edit-entity="fac" data-record='<%- JSON.stringify(facEditData).split("'").join("&#39;") %>'>Edit</button>
            <form action="/admin/faculty/<%= f.id %>/delete" method="POST" class="inline-form">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <button type="submit" class="btn btn-outline btn-sm" data-confirm="Delete this faculty member?">Delete</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
