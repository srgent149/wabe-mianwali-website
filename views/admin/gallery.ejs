<div class="admin-topline"><h2>Gallery Categories</h2></div>

<div class="admin-panel">
  <h3 id="form-title">Add / Edit Gallery Category</h3>
  <form action="/admin/gallery" method="POST" id="gc-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <input type="hidden" name="id" id="gc-id" value="" />
    <div class="form-grid">
      <div class="field"><label>Title</label><input type="text" name="title" id="gc-title" required /></div>
      <div class="field">
        <label>Color Theme</label>
        <select name="colorTheme" id="gc-colorTheme">
          <option value="blue">Blue</option>
          <option value="green">Green</option>
        </select>
      </div>
      <div class="field">
        <label>Icon</label>
        <select name="iconKey" id="gc-iconKey">
          <option value="building">Building</option>
          <option value="microscope">Microscope</option>
          <option value="trophy">Trophy</option>
          <option value="mic">Microphone</option>
          <option value="laptop">Laptop</option>
          <option value="book">Book</option>
          <option value="globe">Globe</option>
          <option value="cap">Graduation Cap</option>
          <option value="camera">Camera</option>
        </select>
      </div>
      <div class="field"><label>Display Order</label><input type="number" name="displayOrder" id="gc-displayOrder" value="0" /></div>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <button type="button" class="btn btn-outline" data-reset-form="gc-form" data-reset-id="gc-id">Clear</button>
  </form>
</div>

<div class="table-wrap">
  <table class="data-table">
    <thead><tr><th>Title</th><th>Color</th><th>Icon</th><th>Order</th><th></th></tr></thead>
    <tbody>
      <% categories.forEach(function(c) { %>
        <tr>
          <td><%= c.title %></td>
          <td><%= c.colorTheme %></td>
          <td><%= c.iconKey %></td>
          <td><%= c.displayOrder %></td>
          <td style="white-space:nowrap;">
            <button type="button" class="btn btn-outline btn-sm" data-edit-entity="gc" data-record='<%- JSON.stringify(c).split("'").join("&#39;") %>'>Edit</button>
            <form action="/admin/gallery/<%= c.id %>/delete" method="POST" class="inline-form">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <button type="submit" class="btn btn-outline btn-sm" data-confirm="Delete this category?">Delete</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
