# Copy this file to .env and fill in real values for your environment.

# Database
# Local dev default (SQLite, zero setup): file:./dev.db
# Production (PostgreSQL): postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public
DATABASE_URL="file:./dev.db"

# App
PORT=3000
NODE_ENV=development
SESSION_SECRET="change-this-to-a-long-random-string"

# SMTP (leave blank in dev to auto-fallback to console-logged emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="WABE International School <no-reply@wabemianwali.edu.pk>"

# School contact / site settings
SCHOOL_OFFICE_EMAIL="office@wabemianwali.edu.pk"
SCHOOL_HR_EMAIL="careers@wabemianwali.edu.pk"
SCHOOL_ADDRESS="WABE International School, Mianwali Campus, Mianwali, Punjab, Pakistan"
SCHOOL_PHONE="+92 300 0000000"
SCHOOL_WHATSAPP_NUMBER="923000000000"
GOOGLE_MAPS_EMBED_URL="https://www.google.com/maps?q=Mianwali,Punjab,Pakistan&output=embed"

# Seeded admin login (used by prisma/seed.js)
ADMIN_SEED_EMAIL="admin@wabemianwali.edu.pk"
ADMIN_SEED_PASSWORD="ChangeMe123!"
