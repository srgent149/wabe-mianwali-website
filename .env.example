# Copy this file to .env and fill in real values for your environment.

# Database (PostgreSQL / Supabase)
# DATABASE_URL: pooled connection (used by the running app) — Supabase "Transaction pooler", port 6543
# DIRECT_URL:   direct connection (used only by `prisma migrate`) — Supabase "Direct connection", port 5432
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# App
PORT=3000
NODE_ENV=development
SESSION_SECRET="change-this-to-a-long-random-string"

# SMTP (leave blank in dev to auto-fallback to console-logged emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="WABE International School <no-reply@wabemianwali.edu.pk>"

# School contact / site settings
SCHOOL_OFFICE_EMAIL="thewabeinternational@gmail.com"
SCHOOL_HR_EMAIL="thewabeinternational@gmail.com"
SCHOOL_ADDRESS="Near Central Jail, Talagang Road, Mianwali, Punjab, Pakistan"
SCHOOL_PHONE="0300-8439223"
SCHOOL_PHONE_SECONDARY="0301-3954549"
SCHOOL_WHATSAPP_NUMBER="923008439223"
GOOGLE_MAPS_EMBED_URL="https://www.google.com/maps?q=Mianwali,Punjab,Pakistan&output=embed"

# Seeded admin login (used by prisma/seed.js for full demo data,
# or prisma/seedAdminOnly.js to create just the admin login on production)
ADMIN_SEED_EMAIL="admin@wabemianwali.edu.pk"
ADMIN_SEED_PASSWORD="ChangeMe123!"
